# ==========================================
# KinerjaKu — Environment Variables Template
# ==========================================
# Salin file ini menjadi .env.local untuk konfigurasi lokal.
# DILARANG MENYIMPAN CREDENTIAL / SECRET ASLI DI FILE INI ATAU REPOSITORY.

# Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Basis Data (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinerjaku

# Supabase (Opsi Cloud Database, Auth & Object Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=evidence-files

# AI Provider (Google Gemini API — Digunakan di Sisi Server Saja)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Batas Maksimal Ukuran Unggah Berkas (dalam bytes, default 15MB)
MAX_FILE_SIZE_BYTES=15728640

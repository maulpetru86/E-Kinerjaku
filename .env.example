# ====================================================================
# Konfigurasi Lingkungan KinerjaKu (.env.local)
# Salin berkas ini ke .env.local dan sesuaikan nilai konfigurasinya.
# JANGAN PERNAH menyimpan kredensial atau API key di repositori git.
# ====================================================================

# Google Gemini API Key untuk Asisten AI KinerjaKu
# Dapatkan API key gratis di Google AI Studio: https://aistudio.google.com/
# Jika dibiarkan kosong, asisten AI akan berjalan dalam Mode Offline/Fallback aman.
GEMINI_API_KEY=

# Model Gemini yang digunakan (default: gemini-2.0-flash yang cepat dan hemat kuota)
GEMINI_MODEL=gemini-2.0-flash
